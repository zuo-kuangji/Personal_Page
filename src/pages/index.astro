---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import NewsList from "../components/NewsList.astro";
import PublicationList from "../components/PublicationList.astro";
import { profile, sameAsLinks } from "../content/profile";
import { sections } from "../content/publications";
import { plain, summary } from "../lib/agents";

const scholar = profile.links.find((link) => link.label === "Google Scholar");
const authorName = (author: string) => author.replace(/[*†‡]+$/, "");

// schema.org data that search engines and AI agents read to understand who this is.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: [profile.chineseName, profile.displayName, ...profile.aliases],
  description: summary,
  url: `${profile.homepage}/`,
  image: `${profile.homepage}${profile.portrait}`,
  email: `mailto:${profile.email}`,
  jobTitle: profile.role,
  workLocation: { "@type": "Place", name: profile.location },
  affiliation: {
    "@type": "Organization",
    name: "MARS Lab, Nanyang Technological University",
    url: "https://www.ntu.edu.sg/",
  },
  advisor: {
    "@type": "Person",
    name: profile.advisor.name,
    url: profile.advisor.url,
  },
  knowsAbout: [...profile.seoKeywords, ...profile.handsOn],
  sameAs: sameAsLinks,
  subjectOf: sections.flatMap((section) =>
    section.papers.map((pub) => ({
      "@type": "ScholarlyArticle",
      headline: plain(pub.title),
      url: pub.links[0]?.href,
      author: pub.authors.map((author) => ({ "@type": "Person", name: authorName(author) })),
      datePublished: pub.venue.match(/\d{4}/)?.[0],
      publication: pub.venue,
      about: section.title,
      keywords: pub.tags.join(", "),
    })),
  ),
};
---

<BaseLayout
  title={`${profile.name} (${profile.chineseName}) | Humanoid Robots, Dexterous Hands, Embodied AI`}
  description="Kuangji Zuo (左匡济), graduate researcher at NTU MARS Lab. Embodied AI for humanoid robots and dexterous hands: VLA and world action models, robot action generation (ODE Policy, Δ-flow, UCA-Flow), humanoid locomotion, and gaze-based human-robot interaction (Gaze2Act)."
  keywords={[...profile.seoKeywords]}
  canonical={`${profile.homepage}/`}
  image={profile.portrait}
  structuredData={structuredData}
>
  <Hero />

  <main class="mx-auto max-w-[52rem] px-5 pb-10 sm:px-8">
    <section id="news" class="mt-16">
      <SectionHeading title="News" />
      <NewsList />
    </section>

    <section id="publications" class="mt-16">
      <SectionHeading title="Publications">
        {scholar && <a class="text-sm text-muted hover:text-accent" href={scholar.href}>Full list on Google Scholar →</a>}
      </SectionHeading>
      <p class="-mt-2 mb-6 text-[0.82rem] text-muted">* Equal contribution &nbsp;† Corresponding author</p>
      <PublicationList />
    </section>

    <footer class="mt-20 flex flex-col items-center gap-2 text-[0.75rem] text-muted/70">
      <img class="h-11 w-11 opacity-75 dark:invert" src="/images/signature-ji.png" alt="济" width="160" height="160" />
      <span>Last updated Nov 2026</span>
    </footer>
  </main>
</BaseLayout>
