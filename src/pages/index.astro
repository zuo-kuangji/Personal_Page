---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import NewsList from "../components/NewsList.astro";
import PublicationList from "../components/PublicationList.astro";
import { profile, sameAsLinks } from "../content/profile";
import { sections } from "../content/publications";

const scholar = profile.links.find((link) => link.label === "Google Scholar");

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: [profile.chineseName, profile.displayName, ...profile.aliases],
  url: profile.homepage,
  image: `${profile.homepage}${profile.portrait}`,
  email: `mailto:${profile.email}`,
  jobTitle: profile.role,
  affiliation: {
    "@type": "Organization",
    name: "MARS Lab, Nanyang Technological University",
    url: "https://www.ntu.edu.sg/",
  },
  advisor: {
    "@type": "Person",
    name: profile.advisor.name,
    url: profile.advisor.url,
  },
  knowsAbout: profile.seoKeywords,
  sameAs: sameAsLinks,
  subjectOf: sections.flatMap((section) => section.papers).map((pub) => ({
    "@type": "ScholarlyArticle",
    headline: pub.title,
    url: pub.links[0]?.href,
  })),
};
---

<BaseLayout
  title={`${profile.name} (${profile.chineseName}) | Robot Learning, Humanoids, VLA`}
  description="Kuangji Zuo (左匡济) is a graduate researcher at NTU MARS Lab working on embodied AI for humanoid robots: VLA models, world action models, robot action generation (ODE Policy, Δ-flow), and gaze-based human-robot interaction (Gaze2Act)."
  keywords={profile.seoKeywords}
  canonical={`${profile.homepage}/`}
  image={profile.portrait}
  structuredData={structuredData}
>
  <main class="mx-auto max-w-[52rem] px-5 pb-10 pt-12 sm:px-8 sm:pt-20">
    <Hero />

    <section id="news" class="mt-16">
      <SectionHeading title="News" />
      <NewsList />
    </section>

    <section id="publications" class="mt-16">
      <SectionHeading title="Publications">
        {scholar && <a class="text-sm text-muted hover:text-accent" href={scholar.href}>Full list on Google Scholar →</a>}
      </SectionHeading>
      <p class="-mt-2 mb-6 text-[0.82rem] text-muted">* Equal contribution &nbsp;† Corresponding author</p>
      <PublicationList />
    </section>

    <footer class="mt-20 text-center text-[0.75rem] text-muted/70">Last updated Nov 2026</footer>
  </main>
</BaseLayout>
