---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PublicationList from "../components/PublicationList.astro";
import { profile, researchDirections, sameAsLinks } from "../content/profile";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: [profile.chineseName, profile.displayName, ...profile.aliases],
  url: profile.homepage,
  image: `${profile.homepage}${profile.portrait}`,
  email: "mailto:kuangji001@e.ntu.edu.sg",
  jobTitle: profile.role,
  affiliation: {
    "@type": "Organization",
    name: "MARS Lab, Nanyang Technological University",
    url: "https://www.ntu.edu.sg/",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Nanyang Technological University",
    url: "https://www.ntu.edu.sg/",
  },
  advisor: {
    "@type": "Person",
    name: profile.advisor.name,
    url: profile.advisor.url,
  },
  knowsAbout: profile.seoKeywords,
  sameAs: sameAsLinks,
};
---

<BaseLayout
  title={`${profile.name} (${profile.chineseName}) | Embodied AI, Humanoid Robotics, VLA`}
  description="Kuangji Zuo (左匡济) is a graduate researcher at NTU MARS Lab working on embodied AI, humanoid robotics, human-robot interaction, VLA, whole-body action models, WAM, and intent-aware robot learning."
  keywords={profile.seoKeywords}
  canonical={profile.homepage}
  structuredData={structuredData}
>
  <header class="sticky top-0 z-50 border-b border-rule bg-paper/90 backdrop-blur">
    <nav class="mx-auto flex h-12 max-w-5xl items-center gap-5 overflow-x-auto px-5 text-sm sm:justify-between sm:px-8">
      <a class="shrink-0 font-semibold text-ink" href="#top">{profile.name}</a>
      <div class="flex shrink-0 items-center gap-5 text-muted">
        <a class="hover:text-ink" href="#research">Research</a>
        <a class="hover:text-ink" href="#publications">Publications</a>
        <a class="hover:text-ink" href="#about">About</a>
        <a class="hover:text-ink" href="#contact">Contact</a>
      </div>
    </nav>
  </header>

  <main id="top">
    <Hero />

    <section id="research" class="mx-auto max-w-5xl px-5 py-10 sm:px-8 md:py-12">
      <SectionHeading eyebrow="Research" title="Embodied AI for natural human-robot interaction" nowrap />
      <div class="grid gap-4 md:grid-cols-3">
        {researchDirections.map((item) => (
          <article class="rounded-md border border-rule bg-card p-5 shadow-[0_10px_30px_rgba(22,23,22,0.04)]">
            <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-muted">{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="publications" class="mx-auto max-w-5xl px-5 py-10 sm:px-8 md:py-12">
      <SectionHeading eyebrow="Publications" title="Selected publications and preprints" />
      <PublicationList />
    </section>

    <section id="about" class="mx-auto grid max-w-5xl gap-6 px-5 py-10 sm:px-8 md:grid-cols-[160px_1fr] md:py-12">
      <h2 class="text-2xl font-semibold text-ink">About</h2>
      <div class="space-y-4 text-[0.98rem] leading-8 text-muted">
        <p>
          {profile.summary}
        </p>
        <p>
          I work on robot policies that connect high-level human intent with physically grounded action, with a focus on ambiguous interaction settings where gaze, language, and context can help robots choose the right behavior.
        </p>
        <p>
          Search and research keywords associated with my work include embodied AI, humanoid robotics, human-robot interaction, VLA, whole-body VLA, whole-body action models, WAM, gaze-conditioned robot learning, and intent-aware robot policies.
        </p>
      </div>
    </section>

    <section id="contact" class="border-t border-rule bg-card">
      <div class="mx-auto grid max-w-5xl gap-6 px-5 py-10 sm:px-8 md:grid-cols-[160px_1fr] md:py-12">
        <h2 class="text-2xl font-semibold text-ink">Contact</h2>
        <div>
          <p class="max-w-2xl text-[0.98rem] leading-8 text-muted">
            For research conversations or collaboration, reach me at
            <a class="font-semibold text-ink underline decoration-rule underline-offset-4 hover:text-red" href="mailto:kuangji001@e.ntu.edu.sg">
              kuangji001@e.ntu.edu.sg
            </a>.
            You can also find my academic and project updates through the links below.
          </p>
          <div class="mt-5 flex flex-wrap gap-4 text-sm font-semibold">
            {profile.links.map((link) => (
              <a class="text-ink underline decoration-rule underline-offset-4 hover:text-red" href={link.href}>
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-rule px-5 py-7 sm:px-8">
    <div class="mx-auto flex max-w-5xl flex-col justify-between gap-3 text-sm text-muted sm:flex-row">
      <span>{profile.name}</span>
      <span>Embodied AI | Humanoid Robotics | HRI</span>
    </div>
  </footer>
</BaseLayout>
