---
interface Props {
  eyebrow: string;
  title: string;
  nowrap?: boolean;
}

const { eyebrow, title, nowrap = false } = Astro.props;
---

<div class="mb-8 flex items-end justify-between gap-6 border-b border-rule pb-4">
  <div>
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-red">{eyebrow}</p>
    <h2
      class:list={[
        "mt-2 max-w-3xl text-3xl font-semibold text-ink sm:text-4xl",
        nowrap && "md:max-w-none md:whitespace-nowrap",
      ]}
    >
      {title}
    </h2>
  </div>
  <div class="hidden h-px flex-1 bg-rule md:block"></div>
</div>
