---
import Authors from "./Authors.astro";
import { sections } from "../content/publications";
import { ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const labels: Record<string, string> = ui[lang].linkLabels;

const linkClass = "text-ink underline decoration-rule underline-offset-4 hover:text-accent";
const mainLink = (links: { label: string; href: string }[]) =>
  links.find((l) => l.label === "Project")?.href ?? links[0].href;
---

{
  sections.map((section) => (
    <div class="mt-10 first:mt-0">
      <h3 class="mb-5 text-[0.8rem] font-semibold uppercase tracking-[0.12em] text-accent">{lang === "zh" ? section.titleZh : section.title}</h3>
      <div class={section.compact ? "space-y-5" : "space-y-8"}>
        {section.papers.map((pub) => (
          <article class:list={[!section.compact && "grid gap-4 sm:grid-cols-[13rem_minmax(0,1fr)] sm:gap-6"]}>
            {!section.compact && (
              <a
                href={mainLink(pub.links)}
                class="group relative block self-start overflow-hidden rounded-md border border-rule bg-white"
                data-hover-clip={pub.clip ? `/videos/${pub.clip}.mp4` : undefined}
              >
                <img
                  class="aspect-[16/10] w-full object-contain p-1"
                  src={pub.image}
                  alt={pub.title}
                  loading="lazy"
                  decoding="async"
                />
                {pub.clip && (
                  <video
                    class="absolute inset-0 h-full w-full bg-white object-cover opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100"
                    poster={`/videos/${pub.clip}.jpg`}
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-hidden="true"
                  />
                )}
              </a>
            )}
            <div>
              <h4 class:list={["leading-snug text-ink", section.compact ? "font-medium" : "font-semibold"]}>
                {pub.title}
                {pub.badge && (
                  <span class="ml-1.5 inline-block rounded bg-accent/10 px-1.5 py-0.5 align-middle text-[0.7rem] font-semibold text-accent">
                    {pub.badge}
                  </span>
                )}
              </h4>
              <div class="mt-1">
                <Authors authors={pub.authors} />
              </div>
              <p class="mt-0.5 text-[0.88rem] text-muted">
                <span class="italic">{pub.venue}</span>
                {pub.links.map((link) => (
                  <>
                    <span class="mx-1.5 text-rule">/</span>
                    <a class={linkClass} href={link.href}>{labels[link.label] ?? link.label}</a>
                  </>
                ))}
              </p>
              <ul class="mt-2 flex flex-wrap gap-1.5" aria-label="Tags">
                {pub.tags.map((tag) => (
                  <li class="rounded bg-ink/[0.06] px-1.5 py-0.5 text-[0.72rem] font-medium text-muted">{tag}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  ))
}

<script>
  // Covers show the paper figure; hovering plays the clip (like a GIF). Clips load on first hover.
  document.querySelectorAll<HTMLAnchorElement>("a[data-hover-clip]").forEach((link) => {
    const video = link.querySelector("video");
    if (!video) return;
    const start = () => {
      if (!video.src) video.src = link.dataset.hoverClip!;
      video.play().catch(() => {});
    };
    const stop = () => {
      video.pause();
      video.currentTime = 0;
    };
    link.addEventListener("mouseenter", start);
    link.addEventListener("mouseleave", stop);
    link.addEventListener("focus", start);
    link.addEventListener("blur", stop);
  });
</script>
