---
import { profile } from "../content/profile";
---

<section class="grid items-start gap-8 sm:grid-cols-[minmax(0,1fr)_10rem] sm:gap-10">
  <div>
    <h1 class="text-[2rem] font-semibold leading-tight tracking-[-0.02em] text-ink">
      {profile.name}
      <span class="ml-2 text-[0.7em] font-normal tracking-normal text-muted">{profile.chineseName}</span>
    </h1>

    <div class="mt-4 space-y-3 text-[0.97rem] leading-7 text-ink/90">
      <p>
        I am a graduate researcher at <strong class="font-semibold">MARS Lab</strong>, Nanyang Technological
        University, advised by <a class="link" href={profile.advisor.url}>{profile.advisor.name}</a>.
      </p>
      <p>
        My research focuses on embodied AI for humanoid robots: vision-language-action (VLA) models, world action
        models, and how robot policies generate actions. I am also interested in natural human-robot interaction,
        where people guide robots through gaze, language, and context.
      </p>
    </div>

    <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-[0.95rem]">
      {profile.links.map((link) => <a class="link font-medium" href={link.href}>{link.label}</a>)}
    </p>
  </div>

  <img
    class="order-first aspect-square w-32 rounded-full object-cover sm:order-none sm:w-full"
    src={profile.portrait}
    alt={`Portrait of ${profile.name}`}
    width="800"
    height="800"
    loading="eager"
  />
</section>
