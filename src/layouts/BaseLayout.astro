---
import "@fontsource-variable/inter";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  keywords?: string[];
  canonical?: string;
  image?: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, keywords = [], canonical, image, structuredData } = Astro.props;
const imageUrl = image ? new URL(image, Astro.site ?? canonical).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <meta name="author" content="Kuangji Zuo" />
    <meta name="robots" content="index, follow" />
    <!-- Search engine ownership verification (public tokens). -->
    <meta name="google-site-verification" content="8y7SDRq0fqru1kJJmhqX1gR7tDet1exCDwVVeCiac70" />
    <meta name="geo.region" content="SG" />
    <meta name="geo.placename" content="Singapore" />
    <meta name="institution" content="MARS Lab, Nanyang Technological University" />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    {canonical && <meta property="og:url" content={canonical} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta property="og:site_name" content="Kuangji Zuo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="text/markdown" href="/index.md" title="Profile in Markdown" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Summary for AI agents (llms.txt)" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
